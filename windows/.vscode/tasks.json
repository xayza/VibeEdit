{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run VibeEdit",
      "type": "shell",
      "command": "python vibeedit.py serve --port 8000 --open-browser",
      "options": {"cwd": "${workspaceFolder}"},
      "presentation": {"reveal": "always", "panel": "shared"},
      "problemMatcher": []
    },
    {
      "label": "Update & Run VibeEdit",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/update_and_run.ps1",
      "options": {"cwd": "${workspaceFolder}"},
      "presentation": {"reveal": "always", "panel": "shared"},
      "problemMatcher": []
    }
  ]
}
